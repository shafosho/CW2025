<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import java.net.URL?>

<StackPane fx:controller="com.comp2042.gui.MenuController"
           xmlns:fx="http://javafx.com/fxml"
           prefWidth="600" prefHeight="600"
           styleClass="root">

    <VBox alignment="CENTER" spacing="20" style="-fx-background-color: rgba(0, 0, 0, 0.5); -fx-padding: 50; -fx-background-radius: 20;">

        <Label text="TETRIS" styleClass="gameOverStyle" style="-fx-font-size: 80px; -fx-text-fill: cyan; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.8), 10, 0, 0, 0);"/>

        <Button text="START GAME" onAction="#onStartGame"
                style="-fx-font-family: 'Let\'s go Digital'; -fx-font-size: 24px; -fx-base: #2A5058; -fx-text-fill: white; -fx-cursor: hand;"/>

        <Button text="HIGH SCORES" onAction="#onHighScores"
                style="-fx-font-family: 'Let\'s go Digital'; -fx-font-size: 24px; -fx-base: #2A5058; -fx-text-fill: white; -fx-cursor: hand;"/>

        <Button text="EXIT" onAction="#onExit"
                style="-fx-font-family: 'Let\'s go Digital'; -fx-font-size: 24px; -fx-base: #8b0000; -fx-text-fill: white; -fx-cursor: hand;"/>
    </VBox>

    <stylesheets>
        <URL value="@window_style.css"/>
    </stylesheets>
</StackPane>